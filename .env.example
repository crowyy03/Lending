# AmoCRM — заявки с лендинга создают сделку и контакт.
# Инструкция: docs/AMOCRM_SETUP.md

AMOCRM_SUBDOMAIN=your_subdomain
AMOCRM_ACCESS_TOKEN=your_access_token

# Опционально: воронка и статус по умолчанию
# AMOCRM_PIPELINE_ID=
# AMOCRM_STATUS_ID=

# Опционально: ID поля «Примечание» у сделки — сюда пишутся адрес, покрытие, высота, использование, заметки
# AMOCRM_FIELD_LEAD_NOTES=
